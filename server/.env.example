# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real ".env" to version control.

# Your mail provider's SMTP server. Ask IT which one your company uses —
# common examples: smtp.office365.com (Microsoft 365), smtp.gmail.com (Google
# Workspace), or a transactional service like SendGrid/SES/Mailgun.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-account@aes-energy.com
SMTP_PASSWORD=your-password-or-app-password
SMTP_FROM=your-sending-account@aes-energy.com
SMTP_USE_TLS=true

# --- Login ---
# Random long string used to sign login session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this fixed once set — changing it logs everyone out.
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Everyone logs in with an @aes-energy.com email + the same shared password
# (see the security note in auth.py — fine for a pilot, not for production
# without tightening). Change SHARED_PASSWORD any time and restart the
# server to rotate it for everyone at once.
ADMIN_EMAIL=admin@aes-energy.com
SHARED_PASSWORD=aes

# --- SMS (driver "on the way" texts) ---
# Sign up at twilio.com, get a phone number capable of SMS, and copy these
# from the console dashboard. A trial account can only text verified
# numbers until upgraded — fine for testing, not for a real fleet.
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# --- Maps (ETA calculation) ---
# Google Cloud Console -> enable "Distance Matrix API" -> Credentials ->
# create an API key. Requires billing enabled on the project (free monthly
# quota covers light use, but Google still requires a card on file).
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key

# --- Public URL (used in email links) ---
# Your real domain, or your current tunnel URL while testing (e.g. the
# https://....trycloudflare.com address). Used so links in the daily
# inventory report email actually resolve to something real.
PUBLIC_BASE_URL=https://your-domain-or-tunnel-url

